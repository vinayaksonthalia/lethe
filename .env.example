# Lethe — example environment. Copy to .env and fill in ONE LLM key.
#   cp .env.example .env
# Embeddings run locally (fastembed) — you only need an LLM key.
# Tested end-to-end on Groq's free tier; any OpenAI-compatible provider works.

# ── LLM (pick ONE provider block) ──────────────────────────────────────────
# Default: Groq free tier (get a key at https://console.groq.com/keys)
LLM_PROVIDER="custom"
LLM_MODEL="openai/llama-3.3-70b-versatile"
LLM_ENDPOINT="https://api.groq.com/openai/v1"
LLM_API_KEY="gsk_your_groq_key_here"
LLM_ARGS='{"temperature": 0.0}'          # temp 0 = the demo regime; keep it
COGNEE_SKIP_CONNECTION_TEST="true"

# --- Alt: OpenRouter ---
# LLM_MODEL="openrouter/meta-llama/llama-3.3-70b-instruct"
# LLM_ENDPOINT="https://openrouter.ai/api/v1"
# LLM_API_KEY="sk-or-v1-your_openrouter_key_here"

# --- Alt: local Ollama (free, fully offline) ---
# LLM_PROVIDER="ollama"
# LLM_MODEL="qwen2.5:7b"                  # qwen2.5 recommended for ingest
# LLM_ENDPOINT="http://localhost:11434/v1"
# LLM_API_KEY="ollama"
# LLM_INSTRUCTOR_MODE="json_schema_mode"

# ── Embeddings: local, free, offline (no key needed) ───────────────────────
EMBEDDING_PROVIDER="fastembed"
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
EMBEDDING_DIMENSIONS=384

# ── Local databases (isolated to this project) ─────────────────────────────
DB_PROVIDER="sqlite"
VECTOR_DB_PROVIDER="lancedb"
GRAPH_DATABASE_PROVIDER="kuzu"
# Use a NO-SPACE absolute path — LanceDB/Kuzu can mishandle spaces.
DATA_ROOT_DIRECTORY="/absolute/path/to/.cognee-lethe/data"
SYSTEM_ROOT_DIRECTORY="/absolute/path/to/.cognee-lethe/system"
LITELLM_LOG="ERROR"

# ── Optional ───────────────────────────────────────────────────────────────
# Require Authorization: Bearer <token> on API routes (off by default).
# LETHE_AUTH_TOKEN="choose-a-shared-secret"
# How strongly demoted (aging) knowledge sinks in answers, 0.0–1.0 (default 0.6).
# LETHE_FEEDBACK_INFLUENCE="0.6"
# Per-IP rate limit on the mutating/quota-spending routes (forget, upload, curation,
# llm-config). Format "N/S" = N requests per S seconds. Unset = OFF (local demo unaffected).
# LETHE_RATE_LIMIT="20/60"
